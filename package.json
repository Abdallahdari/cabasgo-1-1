{
  "name": "codka-bulshada",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:check": "tsx --conditions=react-server scripts/check-db.ts",
    "db:seed": "tsx --conditions=react-server scripts/seed.ts",
    "db:indexes": "tsx --conditions=react-server scripts/sync-indexes.ts",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "jobs:cleanup-orphans": "tsx --conditions=react-server scripts/cleanup-orphans.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/client-sesv2": "^3.1176.0",
    "@aws-sdk/s3-presigned-post": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.79.0",
    "mongoose": "^9.13.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "aws-sdk-client-mock": "^4.1.0",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "mongodb-memory-server": "^11.4.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
