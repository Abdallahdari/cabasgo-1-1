# =============================================================================
# Codka Bulshada — environment configuration
# Copy to `.env.local` for development. NEVER commit real secrets.
# In AWS (ECS Fargate) these are set on the task definition; values marked
# [secret] must come from AWS Secrets Manager, not plain environment variables.
# =============================================================================

# --- Application -------------------------------------------------------------
# development | staging | production. staging/production enforce SES, S3 and https.
APP_ENV=development
# Public base URL used in email links. Must be https:// in production.
APP_URL=http://localhost:3000
# Session lifetime (days). Sessions are server-side and revocable.
SESSION_TTL_DAYS=14
# Reverse proxies in front of the app that append to X-Forwarded-For.
# CloudFront -> ALB -> ECS = 2, ALB -> ECS = 1, local = 0.
TRUSTED_PROXY_HOPS=0

# Users may post/comment/upload without verifying their email unless this is true.
REQUIRE_EMAIL_VERIFICATION=false

# --- MongoDB Atlas -----------------------------------------------------------
# [secret] Atlas SRV connection string for a dedicated database user with
# readWrite on MONGODB_DB_NAME only. Restrict Atlas network access to the
# VPC (PrivateLink / peering) or the NAT gateway IPs.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=codka-bulshada
MONGODB_DB_NAME=codka_bulshada

# --- AWS (general) -----------------------------------------------------------
# Credentials are NOT configured here. In ECS the task IAM role is used.
# Locally, use `aws configure sso` / a named profile (AWS_PROFILE=...).
AWS_REGION=eu-west-1
# AWS_PROFILE=codka-dev

# --- Image storage -------------------------------------------------------------
# mongodb = store images in MongoDB GridFS (local development, no AWS needed)
# s3      = private S3 bucket (required for staging/production)
STORAGE_DRIVER=mongodb

# --- Amazon S3 (images / evidence) -------------------------------------------
# Private bucket (Block Public Access ON). Browser uploads use presigned POST.
S3_BUCKET=codka-bulshada-media-dev
S3_UPLOAD_URL_TTL_SECONDS=300
S3_DOWNLOAD_URL_TTL_SECONDS=900
# CloudFront distribution in front of the bucket (Origin Access Control).
# Leave empty in development to fall back to short-lived presigned GET URLs.
CLOUDFRONT_URL=
# Local S3-compatible endpoint (LocalStack/MinIO) — development only.
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# --- Amazon SES (email) ------------------------------------------------------
# `console` prints emails to the server log (development only).
# Production requires `ses` and a verified sending identity (domain).
EMAIL_TRANSPORT=console
SES_FROM_EMAIL="Codka Bulshada <no-reply@example.org>"
SES_CONFIGURATION_SET=

# --- Bootstrap (scripts/create-admin.ts only) --------------------------------
# [secret] Optional. If unset, a random password is generated and printed once.
# ADMIN_PASSWORD=
